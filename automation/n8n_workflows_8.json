{
  "ESIP_n8n_Workflows": {
    "description": "ESIP 8개 워크플로우 — n8n Cloud Import용",
    "setup_note": "각 워크플로우를 n8n > Import Workflow에 붙여넣기",
    "variables_to_replace": {
      "SHEETS_WEBAPP_URL": "Apps Script 배포 후 발급받은 Web App URL",
      "OPENAI_API_KEY": "ChatGPT API Key",
      "GMAIL_ACCOUNT": "알림 수신 이메일",
      "SLACK_WEBHOOK": "Slack 알림 URL (선택)"
    }
  },

  "workflows": [

    {
      "name": "WF1 — Daily Market Intelligence",
      "description": "매일 오전 7시: 시장 뉴스 수집 → Sheets 저장 → Claude 분석 → 이메일 발송",
      "trigger": "Cron: 0 7 * * 1-5",
      "nodes": [
        {
          "id": "trigger_daily",
          "type": "n8n-nodes-base.cron",
          "name": "매일 07:00 트리거",
          "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 7 * * 1-5" }] } }
        },
        {
          "id": "news_search_1",
          "type": "n8n-nodes-base.httpRequest",
          "name": "AI 헬스케어 뉴스 수집",
          "parameters": {
            "url": "https://newsapi.org/v2/everything",
            "method": "GET",
            "qs": {
              "q": "AI 헬스케어 디지털헬스 건강검진 Korea",
              "language": "ko",
              "sortBy": "publishedAt",
              "pageSize": 10,
              "apiKey": "{{$env.NEWS_API_KEY}}"
            }
          }
        },
        {
          "id": "claude_analysis",
          "type": "n8n-nodes-base.httpRequest",
          "name": "Claude API 분석",
          "parameters": {
            "url": "https://api.anthropic.com/v1/messages",
            "method": "POST",
            "headers": {
              "x-api-key": "{{$env.ANTHROPIC_API_KEY}}",
              "anthropic-version": "2023-06-01",
              "content-type": "application/json"
            },
            "body": {
              "model": "claude-opus-4-6",
              "max_tokens": 2000,
              "messages": [{
                "role": "user",
                "content": "다음 뉴스를 전략기획자 관점에서 분석하라. 다나아데이터(AI 헬스케어, 건강검진 플랫폼)에 미치는 영향을 중심으로 정리하라.\n\n뉴스: {{$json.articles}}\n\n출력 형식:\n1. 핵심 트렌드 3가지\n2. 다나아데이터 기회 요인\n3. 다나아데이터 위협 요인\n4. 즉각 모니터링 필요 항목"
              }]
            }
          }
        },
        {
          "id": "save_to_sheets",
          "type": "n8n-nodes-base.httpRequest",
          "name": "Market_DB에 저장",
          "parameters": {
            "url": "SHEETS_WEBAPP_URL",
            "method": "POST",
            "headers": { "Content-Type": "application/json" },
            "body": {
              "sheet": "Market_DB",
              "action": "append",
              "data": {
                "market_name": "Daily Intelligence — {{$now.format('YYYY-MM-DD')}}",
                "segment": "Daily News",
                "key_driver": "{{$node['Claude API 분석'].json.content[0].text}}",
                "source_url": "NewsAPI"
              }
            }
          }
        },
        {
          "id": "send_email",
          "type": "n8n-nodes-base.gmail",
          "name": "일일 브리핑 이메일",
          "parameters": {
            "to": "GMAIL_ACCOUNT",
            "subject": "[ESIP Daily] AI 헬스케어 인텔리전스 — {{$now.format('YYYY-MM-DD')}}",
            "message": "{{$node['Claude API 분석'].json.content[0].text}}"
          }
        }
      ]
    },

    {
      "name": "WF2 — Weekly Competitor Intelligence",
      "description": "매주 월요일 07:00: 경쟁사 업데이트 감지 → Competitor_DB 저장 → Gap Analysis",
      "trigger": "Cron: 0 7 * * 1",
      "competitors": ["GC케어", "카카오헬스케어", "휴레이포지티브", "에임메드", "메디에이지"],
      "nodes": [
        {
          "id": "trigger_weekly",
          "type": "n8n-nodes-base.cron",
          "name": "매주 월요일 07:00",
          "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 7 * * 1" }] } }
        },
        {
          "id": "competitor_news",
          "type": "n8n-nodes-base.httpRequest",
          "name": "경쟁사 뉴스 검색",
          "parameters": {
            "url": "https://newsapi.org/v2/everything",
            "method": "GET",
            "qs": {
              "q": "GC케어 OR 카카오헬스케어 OR 휴레이포지티브 OR 에임메드 OR 메디에이지",
              "language": "ko",
              "sortBy": "publishedAt",
              "pageSize": 20,
              "apiKey": "{{$env.NEWS_API_KEY}}"
            }
          }
        },
        {
          "id": "claude_competitor_analysis",
          "type": "n8n-nodes-base.httpRequest",
          "name": "Claude 경쟁사 분석",
          "parameters": {
            "url": "https://api.anthropic.com/v1/messages",
            "method": "POST",
            "headers": {
              "x-api-key": "{{$env.ANTHROPIC_API_KEY}}",
              "anthropic-version": "2023-06-01",
              "content-type": "application/json"
            },
            "body": {
              "model": "claude-opus-4-6",
              "max_tokens": 3000,
              "messages": [{
                "role": "user",
                "content": "다음 경쟁사 뉴스를 분석하라. 각 기업별로 신규 기능/서비스, 가격 변동, 투자/M&A, 전략 변화를 정리하고, 다나아데이터 대비 위협 수준(상/중/하)을 평가하라.\n\n뉴스: {{$json.articles}}\n\n출력: JSON 형식으로 company_name, update_type, summary, threat_level, action_required 포함"
              }]
            }
          }
        },
        {
          "id": "save_competitor_db",
          "type": "n8n-nodes-base.httpRequest",
          "name": "Competitor_DB 업데이트",
          "parameters": {
            "url": "SHEETS_WEBAPP_URL",
            "method": "POST",
            "headers": { "Content-Type": "application/json" },
            "body": {
              "sheet": "Competitor_DB",
              "action": "append",
              "data": "{{$node['Claude 경쟁사 분석'].json.content[0].text}}"
            }
          }
        },
        {
          "id": "weekly_report_email",
          "type": "n8n-nodes-base.gmail",
          "name": "주간 경쟁사 브리핑",
          "parameters": {
            "to": "GMAIL_ACCOUNT",
            "subject": "[ESIP Weekly] 경쟁사 인텔리전스 — {{$now.format('YYYY-[W]WW')}}",
            "message": "{{$node['Claude 경쟁사 분석'].json.content[0].text}}"
          }
        }
      ]
    },

    {
      "name": "WF3 — Monthly Executive Report",
      "description": "매월 1일 07:00: 전월 데이터 집계 → ChatGPT 분석 → Executive Report 초안 생성",
      "trigger": "Cron: 0 7 1 * *",
      "nodes": [
        {
          "id": "trigger_monthly",
          "type": "n8n-nodes-base.cron",
          "name": "매월 1일 07:00",
          "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 7 1 * *" }] } }
        },
        {
          "id": "read_market_db",
          "type": "n8n-nodes-base.httpRequest",
          "name": "Market_DB 읽기",
          "parameters": {
            "url": "SHEETS_WEBAPP_URL?sheet=Market_DB&limit=50",
            "method": "GET"
          }
        },
        {
          "id": "read_competitor_db",
          "type": "n8n-nodes-base.httpRequest",
          "name": "Competitor_DB 읽기",
          "parameters": {
            "url": "SHEETS_WEBAPP_URL?sheet=Competitor_DB&limit=50",
            "method": "GET"
          }
        },
        {
          "id": "read_policy_db",
          "type": "n8n-nodes-base.httpRequest",
          "name": "Policy_DB 읽기",
          "parameters": {
            "url": "SHEETS_WEBAPP_URL?sheet=Policy_DB&limit=20",
            "method": "GET"
          }
        },
        {
          "id": "chatgpt_executive_report",
          "type": "n8n-nodes-base.httpRequest",
          "name": "ChatGPT Executive Report 생성",
          "parameters": {
            "url": "https://api.openai.com/v1/chat/completions",
            "method": "POST",
            "headers": {
              "Authorization": "Bearer OPENAI_API_KEY",
              "Content-Type": "application/json"
            },
            "body": {
              "model": "gpt-4o",
              "max_tokens": 4000,
              "messages": [
                {
                  "role": "system",
                  "content": "너는 기업전략컨설팅펌의 Principal Consultant다. 임원 보고에 적합한 수준으로 전략 보고서를 작성한다. 결론 먼저, 근거 2~3개, 사업적 의미, 실행 제안 순서로 작성한다."
                },
                {
                  "role": "user",
                  "content": "다음 데이터를 기반으로 다나아데이터의 월간 Executive Report를 작성하라.\n\n시장 데이터: {{$node['Market_DB 읽기'].json}}\n경쟁사 데이터: {{$node['Competitor_DB 읽기'].json}}\n정책 데이터: {{$node['Policy_DB 읽기'].json}}\n\n보고서 구조:\n1. Executive Summary (3줄)\n2. 이달의 핵심 트렌드\n3. 경쟁사 동향 및 위협 평가\n4. 정책/규제 변화\n5. 다나아데이터 전략적 시사점\n6. 다음 달 액션 아이템 (담당자/기한 포함)"
                }
              ]
            }
          }
        },
        {
          "id": "save_report_log",
          "type": "n8n-nodes-base.httpRequest",
          "name": "Report_Log 기록",
          "parameters": {
            "url": "SHEETS_WEBAPP_URL",
            "method": "POST",
            "headers": { "Content-Type": "application/json" },
            "body": {
              "sheet": "Report_Log",
              "action": "append",
              "data": {
                "report_title": "Monthly Executive Report — {{$now.format('YYYY-MM')}}",
                "chapter": "Executive",
                "version": "1.0",
                "status": "Draft",
                "created_by": "n8n-ESIP"
              }
            }
          }
        },
        {
          "id": "monthly_report_email",
          "type": "n8n-nodes-base.gmail",
          "name": "월간 Executive Report 발송",
          "parameters": {
            "to": "GMAIL_ACCOUNT",
            "subject": "[ESIP Monthly] Executive Report — {{$now.format('YYYY년 MM월')}}",
            "message": "{{$node['ChatGPT Executive Report 생성'].json.choices[0].message.content}}"
          }
        }
      ]
    },

    {
      "name": "WF4 — Regulation Monitoring",
      "description": "매주 수요일: 보건복지부/식약처/건보공단 정책 변화 감지 → Policy_DB 저장",
      "trigger": "Cron: 0 8 * * 3",
      "sources": ["보건복지부", "식품의약품안전처", "건강보험공단", "건강보험심사평가원", "디지털헬스케어법"],
      "nodes": [
        {
          "id": "trigger_regulation",
          "type": "n8n-nodes-base.cron",
          "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 8 * * 3" }] } }
        },
        {
          "id": "policy_news_search",
          "type": "n8n-nodes-base.httpRequest",
          "name": "정책 뉴스 검색",
          "parameters": {
            "url": "https://newsapi.org/v2/everything",
            "qs": {
              "q": "보건복지부 OR 식약처 OR 디지털헬스케어 규제 OR AI 의료기기 OR 건강검진 정책",
              "language": "ko",
              "sortBy": "publishedAt",
              "pageSize": 15,
              "apiKey": "{{$env.NEWS_API_KEY}}"
            }
          }
        },
        {
          "id": "claude_policy_analysis",
          "type": "n8n-nodes-base.httpRequest",
          "name": "Claude 정책 분석",
          "parameters": {
            "url": "https://api.anthropic.com/v1/messages",
            "method": "POST",
            "headers": {
              "x-api-key": "{{$env.ANTHROPIC_API_KEY}}",
              "anthropic-version": "2023-06-01",
              "content-type": "application/json"
            },
            "body": {
              "model": "claude-opus-4-6",
              "max_tokens": 2000,
              "messages": [{
                "role": "user",
                "content": "다음 정책/규제 뉴스를 분석하라. 다나아데이터 사업(AI 헬스케어, 건강검진 플랫폼)에 미치는 영향을 중심으로.\n\n뉴스: {{$json.articles}}\n\n출력: policy_name, authority, impact_on_danaa, status(기회/위협/중립), action_required"
              }]
            }
          }
        },
        {
          "id": "save_policy_db",
          "type": "n8n-nodes-base.httpRequest",
          "name": "Policy_DB 저장",
          "parameters": {
            "url": "SHEETS_WEBAPP_URL",
            "method": "POST",
            "body": {
              "sheet": "Policy_DB",
              "action": "append",
              "data": {
                "summary": "{{$node['Claude 정책 분석'].json.content[0].text}}",
                "status": "Active"
              }
            }
          }
        }
      ]
    },

    {
      "name": "WF5 — Investment Monitoring",
      "description": "매주 금요일: 디지털헬스 투자/M&A 동향 → Investment_DB 저장",
      "trigger": "Cron: 0 8 * * 5",
      "nodes": [
        {
          "id": "trigger_investment",
          "type": "n8n-nodes-base.cron",
          "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 8 * * 5" }] } }
        },
        {
          "id": "investment_search",
          "type": "n8n-nodes-base.httpRequest",
          "name": "투자/M&A 뉴스",
          "parameters": {
            "url": "https://newsapi.org/v2/everything",
            "qs": {
              "q": "디지털헬스케어 투자 OR 헬스테크 Series OR AI 의료 M&A OR 건강관리 스타트업 투자",
              "language": "ko",
              "sortBy": "publishedAt",
              "pageSize": 15,
              "apiKey": "{{$env.NEWS_API_KEY}}"
            }
          }
        },
        {
          "id": "claude_investment_parse",
          "type": "n8n-nodes-base.httpRequest",
          "name": "Claude 투자 정보 파싱",
          "parameters": {
            "url": "https://api.anthropic.com/v1/messages",
            "method": "POST",
            "headers": {
              "x-api-key": "{{$env.ANTHROPIC_API_KEY}}",
              "anthropic-version": "2023-06-01",
              "content-type": "application/json"
            },
            "body": {
              "model": "claude-opus-4-6",
              "max_tokens": 2000,
              "messages": [{
                "role": "user",
                "content": "다음 뉴스에서 투자/M&A 정보를 추출하라. JSON 형식: company_name, round, amount_usd, investors, date, use_of_funds, strategic_implication.\n\n뉴스: {{$json.articles}}"
              }]
            }
          }
        },
        {
          "id": "save_investment_db",
          "type": "n8n-nodes-base.httpRequest",
          "name": "Investment_DB 저장",
          "parameters": {
            "url": "SHEETS_WEBAPP_URL",
            "method": "POST",
            "body": {
              "sheet": "Investment_DB",
              "action": "append",
              "data": "{{$node['Claude 투자 정보 파싱'].json.content[0].text}}"
            }
          }
        }
      ]
    },

    {
      "name": "WF6 — Patent Monitoring",
      "description": "매월 15일: 경쟁사 특허 동향 → Patent_DB 저장",
      "trigger": "Cron: 0 9 15 * *",
      "nodes": [
        {
          "id": "trigger_patent",
          "type": "n8n-nodes-base.cron",
          "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 9 15 * *" }] } }
        },
        {
          "id": "patent_search",
          "type": "n8n-nodes-base.httpRequest",
          "name": "특허 뉴스 검색",
          "parameters": {
            "url": "https://newsapi.org/v2/everything",
            "qs": {
              "q": "AI 헬스케어 특허 OR 건강검진 AI 특허 OR 디지털헬스 특허출원",
              "language": "ko",
              "sortBy": "publishedAt",
              "pageSize": 10,
              "apiKey": "{{$env.NEWS_API_KEY}}"
            }
          }
        },
        {
          "id": "claude_patent_analysis",
          "type": "n8n-nodes-base.httpRequest",
          "name": "Claude 특허 분석",
          "parameters": {
            "url": "https://api.anthropic.com/v1/messages",
            "method": "POST",
            "headers": {
              "x-api-key": "{{$env.ANTHROPIC_API_KEY}}",
              "anthropic-version": "2023-06-01",
              "content-type": "application/json"
            },
            "body": {
              "model": "claude-opus-4-6",
              "max_tokens": 1500,
              "messages": [{
                "role": "user",
                "content": "특허 관련 뉴스를 분석하라. company_name, patent_title, technology_area, strategic_implication을 JSON으로 추출하라.\n\n뉴스: {{$json.articles}}"
              }]
            }
          }
        },
        {
          "id": "save_patent_db",
          "type": "n8n-nodes-base.httpRequest",
          "name": "Patent_DB 저장",
          "parameters": {
            "url": "SHEETS_WEBAPP_URL",
            "method": "POST",
            "body": {
              "sheet": "Patent_DB",
              "action": "append",
              "data": "{{$node['Claude 특허 분석'].json.content[0].text}}"
            }
          }
        }
      ]
    },

    {
      "name": "WF7 — Report Generator",
      "description": "수동 트리거 or Webhook: Chapter 지정 → Claude Code 실행 → Google Drive 저장",
      "trigger": "Webhook POST",
      "input_params": {
        "company": "다나아데이터",
        "chapter": "01",
        "chapter_title": "Corporate Diagnosis"
      },
      "nodes": [
        {
          "id": "webhook_trigger",
          "type": "n8n-nodes-base.webhook",
          "name": "Report 생성 요청 수신",
          "parameters": { "path": "esip/report", "method": "POST" }
        },
        {
          "id": "claude_report_gen",
          "type": "n8n-nodes-base.httpRequest",
          "name": "Claude 보고서 생성",
          "parameters": {
            "url": "https://api.anthropic.com/v1/messages",
            "method": "POST",
            "headers": {
              "x-api-key": "{{$env.ANTHROPIC_API_KEY}}",
              "anthropic-version": "2023-06-01",
              "content-type": "application/json"
            },
            "body": {
              "model": "claude-opus-4-6",
              "max_tokens": 4000,
              "messages": [{
                "role": "user",
                "content": "Chapter {{$json.chapter}}. {{$json.chapter_title}}를 컨설팅 최종본 수준으로 작성하라.\n\n대상 기업: {{$json.company}}\n산업: AI 헬스케어, 건강검진 플랫폼\n\n필수 섹션: Executive Summary / Key Findings / Fact Base / Evidence Table / Strategic Analysis / Recommendation / CEO Decision Point / References\n\n임원 보고 수준, 한국어, 출처 포함, 전문용어 영문 병기."
              }]
            }
          }
        },
        {
          "id": "chatgpt_polish",
          "type": "n8n-nodes-base.httpRequest",
          "name": "ChatGPT 문체 개선",
          "parameters": {
            "url": "https://api.openai.com/v1/chat/completions",
            "method": "POST",
            "headers": {
              "Authorization": "Bearer OPENAI_API_KEY",
              "Content-Type": "application/json"
            },
            "body": {
              "model": "gpt-4o",
              "max_tokens": 4000,
              "messages": [
                {
                  "role": "system",
                  "content": "임원 보고서 편집자. 전략 보고서를 CEO가 읽기 적합한 수준으로 다듬는다. 결론 먼저, 간결한 근거, 명확한 액션 아이템."
                },
                {
                  "role": "user",
